# NexaOps Configuration

# LLM Provider: 'fake' (deterministic offline), 'gemini', or 'openai'
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=

# Policy Settings
INVOICE_APPROVAL_THRESHOLD=50000.0
MAX_AGENT_STEPS=15

# Demo / Failure Flags (optional)
# FAIL_MODE=timeout | duplicate | verification_mismatch | missing_data
DEMO_FINANCE_TIMEOUT=false
DEMO_VERIFICATION_MISMATCH=false
